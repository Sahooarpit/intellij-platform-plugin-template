<idea-plugin>
    <id>org.jetbrains.plugins.template</id>
    <name>AI API Client</name>
    <vendor>Arpit Sahoo</vendor>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- The Side Panel -->
        <toolWindow id="AiApiClient"
                    secondary="true"
                    anchor="right"
                    factoryClass="org.jetbrains.plugins.template.toolWindow.MyToolWindowFactory"
                    icon="AllIcons.Actions.Execute"/>

        <!-- Project Service (Implicitly registered via @Service annotation in Kotlin) -->
    </extensions>
</idea-plugin>